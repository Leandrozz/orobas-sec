{
  "openapi": "3.0.3",
  "info": { "title": "API de ejemplo", "version": "1" },
  "servers": [{ "url": "/v1" }],
  "security": [{ "bearer": [] }],
  "paths": {
    "/items/{id}": { "parameters": [{ "name": "id", "in": "path", "required": true }], "get": { "parameters": [{ "$ref": "#/components/parameters/Limit" }], "responses": { "200": { "description": "ok" } } } },
    "/items": { "post": { "security": [], "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Item" } } } }, "responses": { "201": { "description": "ok" } } } }
  },
  "components": {
    "parameters": { "Limit": { "in": "query", "name": "limit", "schema": { "type": "integer" } } },
    "schemas": { "Item": { "type": "object", "properties": { "title": { "type": "string", "example": "mate" }, "qty": { "type": "integer", "example": 2 }, "password": { "type": "string", "example": "clave-openapi" } } } }
  }
}
